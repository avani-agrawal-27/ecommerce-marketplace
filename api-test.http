# Purpose: Update an existing product

PUT {{baseUrl}}/products/94c2a0f5-e629-4748-ab26-8faffddb479f
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Mechanical Keyboard Pro",
  "slug": "mechanical-keyboard-pro",
  "description": "Professional mechanical keyboard with enhanced features",
  "sku": "MK-1001-PRO",
  "price": 7499.99
}

###

# ! TEST 17 - Update Product - NOT FOUND
# Expected: HTTP 404 Not Found

PUT {{baseUrl}}/products/00000000-0000-0000-0000-000000000000
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Test Product",
  "slug": "test-product",
  "description": "Test product",
  "sku": "TEST-1001",
  "price": 999.99
}

###

# ! TEST 18 - Update Product - DUPLICATE SKU
# Expected: HTTP 409 Conflict

PUT {{baseUrl}}/products/94c2a0f5-e629-4748-ab26-8faffddb479f
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Mechanical Keyboard Pro",
  "slug": "mechanical-keyboard-pro",
  "description": "Professional mechanical keyboard with enhanced features",
  "sku": "AF-1001",
  "price": 7499.99
}

