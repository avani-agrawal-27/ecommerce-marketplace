# ! TEST 19 - Deactivate Product - SUCCESS
# Expected: HTTP 200 OK
# Purpose: Deactivate an existing product

PATCH {{baseUrl}}/products/94c2a0f5-e629-4748-ab26-8faffddb479f/status
Content-Type: application/json

{
  "active": false
}

###

# ! TEST 20 - Activate Product - SUCCESS
# Expected: HTTP 200 OK
# Purpose: Reactivate an existing product

PATCH {{baseUrl}}/products/94c2a0f5-e629-4748-ab26-8faffddb479f/status
Content-Type: application/json

{
  "active": true
}

###

# ! TEST 21 - Update Product Status - NOT FOUND
# Expected: HTTP 404 Not Found

PATCH {{baseUrl}}/products/00000000-0000-0000-0000-000000000000/status
Content-Type: application/json

{
  "active": false
}

###

# ! TEST 22 - Update Product Status - VALIDATION FAILURE
# Expected: HTTP 400 Bad Request

PATCH {{baseUrl}}/products/94c2a0f5-e629-4748-ab26-8faffddb479f/status
Content-Type: application/json

{}

###

# ! TEST 23 - Get Products - PAGINATION
# Expected: HTTP 200 OK
# Purpose: Retrieve first page of products

GET {{baseUrl}}/products?page=0&size=2

###

# ! TEST 24 - Get Products - SECOND PAGE
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=1&size=2

###

# ! TEST 25 - Get Products - SORT BY PRICE ASCENDING
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=10&sort=price,asc

###

# ! TEST 26 - Get Products - SORT BY PRICE DESCENDING
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=10&sort=price,desc

###

# ! TEST 27 - Get Products - SORT BY NAME ASC
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=10&sort=name,asc

###

# ! TEST 28 - Get Products - SORT BY NAME DESC
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=10&sort=name,desc

###

# ! TEST 29 - Filter Products - CATEGORY
# Expected: HTTP 200 OK
# Purpose: Return products belonging to Electronics

GET {{baseUrl}}/products?categoryId=bf4de052-2e23-4940-a63d-76b465e0ee2d&page=0&size=10

###

# ! TEST 30 - Filter Products - ACTIVE
# Expected: HTTP 200 OK
# Purpose: Return only active products

GET {{baseUrl}}/products?active=true&page=0&size=10

###

# ! TEST 31 - Filter Products - INACTIVE
# Expected: HTTP 200 OK
# Purpose: Return only inactive products

GET {{baseUrl}}/products?active=false&page=0&size=10

###

# ! TEST 32 - Filter Products - CATEGORY + ACTIVE
# Expected: HTTP 200 OK
# Purpose: Combine multiple filters

GET {{baseUrl}}/products?categoryId=bf4de052-2e23-4940-a63d-76b465e0ee2d&active=true&page=0&size=10

###

# ! TEST 33 - Search Products - NAME
# Expected: HTTP 200 OK
# Purpose: Search product name

GET {{baseUrl}}/products?search=keyboard&page=0&size=10

###

# ! TEST 34 - Search Products - DESCRIPTION
# Expected: HTTP 200 OK
# Purpose: Search product description

GET {{baseUrl}}/products?search=bluetooth&page=0&size=10

###

# ! TEST 35 - Search Products - SKU
# Expected: HTTP 200 OK
# Purpose: Search product SKU

GET {{baseUrl}}/products?search=MK-1001-PRO&page=0&size=10

###

# ! TEST 36 - Search Products - CASE INSENSITIVE
# Expected: HTTP 200 OK
# Purpose: Verify case-insensitive search

GET {{baseUrl}}/products?search=KEYBOARD&page=0&size=10

###

# ! TEST 37 - Search + Category + Active + Sorting
# Expected: HTTP 200 OK
# Purpose: Verify composable product catalog query

GET {{baseUrl}}/products?search=keyboard&categoryId=bf4de052-2e23-4940-a63d-76b465e0ee2d&active=true&page=0&size=10&sort=price,desc

###

# ! TEST 38 - Product List After EntityGraph
# Expected: HTTP 200 OK
# Purpose: Verify product listing still works after changing the fetch strategy

GET {{baseUrl}}/products?page=0&size=10

###

# ! TEST 39 - Pagination - VALID
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=2

###

# ! TEST 40 - Pagination - INVALID PAGE
# Expected: HTTP 400 Bad Request

GET {{baseUrl}}/products?page=-1&size=10

###

# ! TEST 41 - Pagination - INVALID SIZE ZERO
# Expected: HTTP 400 Bad Request

GET {{baseUrl}}/products?page=0&size=0

###

# ! TEST 42 - Pagination - SIZE TOO LARGE
# Expected: HTTP 400 Bad Request

GET {{baseUrl}}/products?page=0&size=1000

###

# ! TEST 43 - Pagination + Sorting
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=10&sort=price,desc

###

# ! TEST 44 - Sorting - VALID FIELD
# Expected: HTTP 200 OK

GET {{baseUrl}}/products?page=0&size=10&sort=price,desc

###

# ! TEST 45 - Sorting - INVALID FIELD
# Expected: HTTP 400 Bad Request

GET {{baseUrl}}/products?page=0&size=10&sort=unknownField,asc

###

# ! TEST 46 - Sorting - INVALID DIRECTION
# Expected: HTTP 400 Bad Request

GET {{baseUrl}}/products?page=0&size=10&sort=price,random

###

# ! TEST 47 - Sorting - MALFORMED PARAMETER
# Expected: HTTP 400 Bad Request

GET {{baseUrl}}/products?page=0&size=10&sort=price,desc,extra

