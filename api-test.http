# ! TEST 48 - Create Inventory
# Expected: HTTP 201 Created

POST {{baseUrl}}/inventory
Content-Type: application/json

{
  "productId": "573bd604-6da8-420e-a66c-46f9dda5152b",
  "quantity": 100
}

###

# ! TEST 49 - Create Inventory For Second Product
# Expected: HTTP 201 Created

POST {{baseUrl}}/inventory
Content-Type: application/json

{
  "productId": "5251aa5c-e99d-4791-ba33-fe45c55f5e9c",
  "quantity": 50
}

###

# ! TEST 50 - Duplicate Inventory
# Expected: HTTP 409 Conflict

POST {{baseUrl}}/inventory
Content-Type: application/json

{
  "productId": "573bd604-6da8-420e-a66c-46f9dda5152b",
  "quantity": 20
}

###

# ! TEST 51 - Inventory For Missing Product
# Expected: HTTP 404 Not Found

POST {{baseUrl}}/inventory
Content-Type: application/json

{
  "productId": "00000000-0000-0000-0000-000000000000",
  "quantity": 10
}

###

# ! TEST 52 - Get Inventory By Product
# Expected: HTTP 200 OK

GET {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b

###

# ! TEST 53 - Get All Inventory
# Expected: HTTP 200 OK

GET {{baseUrl}}/inventory

###

# ! TEST 54 - Add Stock
# Expected: HTTP 200 OK
# Expected quantity: 100 -> 125

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/add
Content-Type: application/json

{
  "quantity": 25
}

###

# ! TEST 55 - Remove Stock
# Expected: HTTP 200 OK
# Expected quantity: 125 -> 105

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/remove
Content-Type: application/json

{
  "quantity": 20
}

###

# ! TEST 56 - Insufficient Stock
# Expected: HTTP 409 Conflict

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/remove
Content-Type: application/json

{
  "quantity": 200
}

###

# ! TEST 57 - Zero Stock Adjustment
# Expected: HTTP 400 Bad Request

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/add
Content-Type: application/json

{
  "quantity": 0
}

###

# ! TEST 58 - Negative Stock Adjustment
# Expected: HTTP 400 Bad Request

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/add
Content-Type: application/json

{
  "quantity": -10
}

###

# ! TEST 59 - Missing Stock Quantity
