@baseUrl = http://localhost:8080/api/v1


# =========================================================
#                    CATEGORY APIs
# =========================================================


# ! TEST 01 - Create Category - SUCCESS
# Expected: HTTP 201 Created
# Purpose: Create a new category successfully

POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Books",
  "slug": "books",
  "description": "Books and reading materials"
}

###


# ! TEST 02 - Create Category - DUPLICATE NAME
# Expected: HTTP 409 Conflict
# Purpose: Verify duplicate category name handling

POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "Books",
  "slug": "books-new",
  "description": "Testing duplicate category name"
}

###


# ! TEST 03 - Create Category - DUPLICATE SLUG
# Expected: HTTP 409 Conflict
# Purpose: Verify duplicate category slug handling

POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "New Books",
  "slug": "books",
  "description": "Testing duplicate category slug"
}

###


# ! TEST 04 - Create Category - VALIDATION FAILURE
# Expected: HTTP 400 Bad Request
# Purpose: Verify @NotBlank validation

POST {{baseUrl}}/categories
Content-Type: application/json

{
  "name": "",
  "slug": "",
  "description": "Invalid category"
}

###


# ! TEST 05 - List Categories
# Expected: HTTP 200 OK
# Purpose: Verify all categories are returned

GET {{baseUrl}}/categories

###



# =========================================================
#                     PRODUCT APIs
# =========================================================


# ! TEST 06 - Create Product - SUCCESS
# Expected: HTTP 201 Created
# Purpose: Create a product using an existing category

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Wireless Headphones",
  "slug": "wireless-headphones",
  "description": "Bluetooth wireless headphones",
  "sku": "WH-1001",
  "price": 2999.99
}

###


# ! TEST 07 - Create Product - SUCCESS
# Expected: HTTP 201 Created
# Purpose: Create another product under a different category

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Mechanical Keyboard",
  "slug": "mechanical-keyboard",
  "description": "Mechanical keyboard for professional and gaming use",
  "sku": "MK-1001",
  "price": 6499.99
}

###


# ! TEST 08 - Create Product - DUPLICATE NAME
# Expected: HTTP 409 Conflict
# Purpose: Verify duplicate product name handling

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Wireless Headphones",
  "slug": "another-headphones",
  "description": "Testing duplicate product name",
  "sku": "WH-1002",
  "price": 1999.99
}

###


# ! TEST 09 - Create Product - DUPLICATE SLUG
# Expected: HTTP 409 Conflict
# Purpose: Verify duplicate product slug handling

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Premium Headphones",
  "slug": "wireless-headphones",
  "description": "Testing duplicate product slug",
  "sku": "WH-1003",
  "price": 3999.99
}

###


# ! TEST 10 - Create Product - DUPLICATE SKU
# Expected: HTTP 409 Conflict
# Purpose: Verify duplicate SKU handling

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": "bf4de052-2e23-4940-a63d-76b465e0ee2d",
  "name": "Gaming Headphones",
  "slug": "gaming-headphones",
  "description": "Testing duplicate product SKU",
  "sku": "WH-1001",
  "price": 4999.99
}

###


# ! TEST 11 - Create Product - INVALID CATEGORY
# Expected: HTTP 404 Not Found
# Purpose: Verify product cannot be created with a non-existing category

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": "00000000-0000-0000-0000-000000000000",
  "name": "Invalid Category Product",
  "slug": "invalid-category-product",
  "description": "This should fail",
  "sku": "INVALID-001",
  "price": 999.99
}

###


# ! TEST 12 - Create Product - VALIDATION FAILURE
# Expected: HTTP 400 Bad Request
# Purpose: Verify request validation

POST {{baseUrl}}/products
Content-Type: application/json

{
  "categoryId": null,
  "name": "",
  "slug": "",
  "description": "",
  "sku": "",
  "price": -100
}

###


# ! TEST 13 - List Products
# Expected: HTTP 200 OK
# Purpose: Verify all products are returned

GET {{baseUrl}}/products

###

# ! TEST 14 - Get Product By ID - SUCCESS
