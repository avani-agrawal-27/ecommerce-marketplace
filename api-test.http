# ! TEST 60 - Inventory Not Found
# Expected: HTTP 404 Not Found

GET {{baseUrl}}/inventory/00000000-0000-0000-0000-000000000000

###

# ! TEST 61 - Add Stock To Missing Inventory
# Expected: HTTP 404 Not Found

PATCH {{baseUrl}}/inventory/00000000-0000-0000-0000-000000000000/stock/add
Content-Type: application/json

{
  "quantity": 10
}

###

# ! TEST 62 - Remove Stock From Missing Inventory
# Expected: HTTP 404 Not Found

PATCH {{baseUrl}}/inventory/00000000-0000-0000-0000-000000000000/stock/remove
Content-Type: application/json

{
  "quantity": 10
}

###

# ! TEST 63 - Remove Entire Available Stock
# Expected: HTTP 200 OK
# Current quantity after previous tests: 105
# This should reduce available stock to 0

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/remove
Content-Type: application/json

{
  "quantity": 105
}

###

# ! TEST 64 - Remove Stock When Available Stock Is Zero
# Expected: HTTP 409 Conflict

PATCH {{baseUrl}}/inventory/573bd604-6da8-420e-a66c-46f9dda5152b/stock/remove
Content-Type: application/json

{
  "quantity": 1
}

